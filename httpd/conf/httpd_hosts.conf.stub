###########################################################################
# 
# Aturan Praktis
# 
# semua host harus didefinisikan disini, supaya tidak lupa/typo/salah.
# penamaan log-file harus disamakan dengan port, supaya mudah ditemukan.
# 
###########################################################################

Listen 5074
Listen 5085

<VirtualHost *:5074>
	ErrorLog "logs/5074.log"
	CustomLog "logs/5074-custom.log" common

	UnsetEnv PHPRC
	FcgidInitialEnv PHPRC "${PHP7_ROOT}"
	FcgidWrapper "${PHP7_ROOT}/php-cgi.exe" .php

	DocumentRoot "C:/projects"
	<Directory "C:/projects">
		Options All
		AllowOverride All
		Require all granted
	</Directory>
</VirtualHost>

<VirtualHost *:5085>
	ErrorLog "logs/5085.log"
	CustomLog "logs/5085-custom.log" common

	UnsetEnv PHPRC
	FcgidInitialEnv PHPRC "${PHP85_ROOT}"
	FcgidWrapper "${PHP85_ROOT}/php-cgi.exe" .php

	DocumentRoot "C:/projects"
	<Directory "C:/projects">
		Options All
		AllowOverride All
		Require all granted
	</Directory>
</VirtualHost>
